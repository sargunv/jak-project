{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 80,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  // Only the files this fork adds. Upstream code keeps upstream's own formatting (`task format`).
  "includes": [
    "android/**",
    "docs/android/**",
    "third-party/glad-gles/README.md",
    "mise.toml",
    "dprint.jsonc",
  ],
  "oxc": {
    "sortImports": { "newlinesBetween": true },
    "lineWidth": 80,
    "proseWrap": "always",
    "sortPackageJson": false,
  },
  "ktfmt": {
    "style": "google",
    "lineWidth": 100,
  },
  "exec": { "commands": [] },
  "plugins": [
    "npm:@dprint/oxc@0.51.0",
    "npm:@dprint/exec@0.9.0/plugin.json@d4f708dc00798b51013ca4e7c26a86656bfb31e7255cdcde28a487f86813e34d",
    "https://plugins.dprint.dev/sargunv/ktfmt-0.65.0.json@d355d4440dda00c0e315b5c39669f417bcfa76b64b68591fa1818f7a1f6b1005",
  ],
}
